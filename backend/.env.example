# Copy this file to .env and fill in the values. .env is git-ignored; never commit real keys.

# Claude API key for the plain-English rule builder (POST /agent/rule).
# Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase Postgres connection string (Supabase dashboard > Connect > Direct > Session pooler, port 5432).
# Port 6543 (transaction pooler) is blocked on some networks. Percent-encode special characters in the password.
# Leave empty to use a local SQLite file at backend/data/app.db.
DATABASE_URL=

# Claude rule-builder limits: runs per visitor per hour, and for the whole site per UTC day.
AGENT_RULES_PER_HOUR=5
AGENT_RULES_PER_DAY=100

# Websites allowed to call the API from a browser, comma-separated (e.g. https://hype-scandal.vercel.app).
# localhost:5173 and localhost:4173 are always allowed for development.
ALLOWED_ORIGINS=

# Header your host fills with the real visitor IP (e.g. x-forwarded-for). Empty = use the connection address.
CLIENT_IP_HEADER=
